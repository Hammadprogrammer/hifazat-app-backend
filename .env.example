# ─── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── NeonDB PostgreSQL (Prisma) ──────────────────────────
# Get this from https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d
# Used to normalize phone numbers without a country code (e.g. 0300...)
DEFAULT_COUNTRY_CODE=+92

# ─── OTP ─────────────────────────────────────────────────
# auto (default): live OTP if any SMS/WhatsApp provider is configured, else static
# live: always send real OTP via OTP_CHANNEL | static: always use STATIC_OTP
OTP_MODE=auto
OTP_CHANNEL=both            # both | sms | whatsapp
OTP_TTL_SECONDS=300
STATIC_OTP=123456           # dev fallback only

# ─── Upstash Redis (OTP store + SOS rate limiting) ───────
# Get these from https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ─── SMS ─────────────────────────────────────────────────
# auto (default) | twilio | gateway | mock
SMS_PROVIDER=auto
# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""                       # e.g. +15005550006
TWILIO_MESSAGING_SERVICE_SID=""      # optional, overrides TWILIO_FROM
# Generic gateway (POST { to, message } with Bearer key)
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""

# ─── WhatsApp ────────────────────────────────────────────
# auto (default) | meta | twilio | mock
WHATSAPP_PROVIDER=auto
# Meta Cloud API — https://developers.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Optional: approved template for business-initiated messages (outside 24h window).
# Template must have exactly one {{1}} body parameter.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG=en
# Twilio WhatsApp (sandbox or approved sender)
TWILIO_WHATSAPP_FROM=""              # e.g. whatsapp:+14155238886

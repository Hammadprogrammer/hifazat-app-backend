# ─── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── NeonDB PostgreSQL (Prisma) ──────────────────────────
# Get this from https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d
# Used to normalize phone numbers without a country code (e.g. 0300...)
DEFAULT_COUNTRY_CODE=+92

# ─── Upstash Redis (SOS rate limiting) ───────────────────
# Get these from https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ─── Expo Push Notifications (app-to-app alerts) ─────────
# Optional. Only needed if "Enhanced Security for Push Notifications" is
# enabled on your Expo project: https://expo.dev → project → Credentials
EXPO_ACCESS_TOKEN=""

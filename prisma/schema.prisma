// HIFATZAT Emergency System — NeonDB PostgreSQL schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  city      String?
  email     String?   @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts  Contact[]
  alerts    Alert[]
  checkins  Checkin[]
  alarms    AlarmSchedule[]
  trips     Trip[]
  settings  Settings?
  streak    UserStreak?

  @@map("users")
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  phone     String
  relation  String?
  priority  Int      @default(3)
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@map("contacts")
}

enum AlertStatus {
  PENDING
  SENT
  PARTIAL
  FAILED
  CANCELLED
  RESOLVED
}

model Alert {
  id          String      @id @default(uuid())
  userId      String
  latitude    Float?
  longitude   Float?
  address     String?
  message     String?
  source      String      @default("sos")
  status      AlertStatus @default(PENDING)
  cancelledAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations   AlertLocation[]

  @@index([userId, createdAt])
  @@map("alerts")
}

model AlertLocation {
  id         String   @id @default(uuid())
  alertId    String
  latitude   Float
  longitude  Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  recordedAt DateTime @default(now())

  alert      Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, recordedAt])
  @@map("alert_locations")
}

model Checkin {
  id          String   @id @default(uuid())
  userId      String
  type        String
  label       String   @default("")
  status      String   @default("safe")
  date        String
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("checkins")
}

model AlarmSchedule {
  id           String  @id @default(uuid())
  userId       String
  label        String
  hour         Int
  minute       Int
  enabled      Boolean @default(true)
  soundEnabled Boolean @default(true)
  sortOrder    Int     @default(0)

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@map("alarm_schedules")
}

model Trip {
  id               String    @id @default(uuid())
  userId           String
  destination      String
  estimatedMinutes Int
  status           String    @default("active")
  overdueNotified  Boolean   @default(false)
  startedAt        DateTime  @default(now())
  endedAt          DateTime?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("trips")
}

model Settings {
  id               String  @id @default(uuid())
  userId           String  @unique
  shakeToAlert     Boolean @default(true)
  keepScreenOn     Boolean @default(false)
  secretRecording  Boolean @default(true)
  lowBatteryAlert  Boolean @default(true)
  simChangeAlert   Boolean @default(true)
  offlineDetection Boolean @default(true)
  countryCode      String  @default("+92")

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model UserStreak {
  id            String   @id @default(uuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  lastFullDate  String?
  milestones    Int[]    @default([])
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}
